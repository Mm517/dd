{
  "rewrites": [
    {
      "source": "/product/:slug",
      "destination": "/product.html"
    },
    {
      "source": "/store/:slug",
      "destination": "/store/index.html"
    },
    {
      "source": "/be-seller",
      "destination": "/be-seller/index.html"
    },
    {
      "source": "/be-seller/:path*",
      "destination": "/be-seller/index.html"
    },
    {
      "source": "/stuff",
      "destination": "/stuff/index.html"
    },
    {
      "source": "/stuff/:path*",
      "destination": "/stuff/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin/index.html"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/category/:slug",
      "destination": "/category/index.html"
    },
    {
      "source": "/offers",
      "destination": "/offers/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/policy",
      "destination": "/policy/index.html"
    },
    {
      "source": "/join-us",
      "destination": "/join-us/index.html"
    },
    {
      "source": "/help",
      "destination": "/help/index.html"
    },
    {
      "source": "/yours-offer",
      "destination": "/yours-offer/index.html"
    },
    {
      "source": "/profile",
      "destination": "/profile/index.html"
    },
    {
      "source": "/profile/my-orders",
      "destination": "/profile/my-orders/index.html"
    },
    {
      "source": "/profile/my-reviews",
      "destination": "/profile/my-reviews/index.html"
    },
    {
      "source": "/track",
      "destination": "/track.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(be-seller|admin|stuff)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/product-:slug.html",
      "destination": "/product/:slug",
      "permanent": true
    },
    {
      "source": "/admin.html",
      "destination": "/admin",
      "permanent": true
    },
    {
      "source": "/Yours-offer",
      "destination": "/yours-offer",
      "permanent": true
    },
    {
      "source": "/account.html",
      "destination": "/profile",
      "permanent": true
    },
    {
      "source": "/policies.html",
      "destination": "/policy",
      "permanent": true
    }
  ]
}
